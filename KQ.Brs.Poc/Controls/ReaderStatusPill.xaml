<UserControl
    x:Class="KQ.Brs.Poc.Controls.ReaderStatusPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border CornerRadius="8" Padding="12,8" Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="Dot" Width="10" Height="10" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1">
                <TextBlock x:Name="Title" Style="{StaticResource BodyStrongTextBlockStyle}" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Detail" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
