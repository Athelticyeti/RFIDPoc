<Page
    x:Class="KQ.Brs.Poc.Views.RampPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KQ.Brs.Poc.ViewModels"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls"
    NavigationCacheMode="Required">

    <Grid Padding="28,12,28,24" RowSpacing="16" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2">
            <TextBlock Text="Loading · Hold 2" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Simulates the rugged handheld at Hold 2: scanning a bag at antenna 3 asks the BRS for a load decision (FR-04/05). Large targets for gloved hands."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Handheld -->
        <StackPanel Grid.Row="1" Spacing="16">
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <Grid ColumnSpacing="24" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="8">
                        <TextBlock Text="Loading into" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <tk:Segmented x:Name="UldSelector" SelectionChanged="Ramp_Changed" FontSize="20">
                            <tk:SegmentedItem Content="ULD AK7" Tag="AK7" MinHeight="56" MinWidth="170" />
                            <tk:SegmentedItem Content="ULD AK8" Tag="AK8" MinHeight="56" MinWidth="170" />
                        </tk:Segmented>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Bottom">
                        <ToggleSwitch x:Name="ArmToggle" Header="Loading antenna (3) armed" OnContent="Scanning" OffContent="Ignoring reads" Toggled="Ramp_Changed" />
                    </StackPanel>
                </Grid>
            </Border>

            <InfoBar x:Name="DisarmedInfo" IsOpen="True" IsClosable="False" Severity="Warning" Title="Loading antenna not armed"
                     Message="Reads at antenna 3 are ignored, so tags lying near it don't raise alarms. Arm it when you are ready to load bags. Manual scans always work." />

            <!-- Last decision: the big answer -->
            <Border x:Name="DecisionCard" Style="{StaticResource CardStyle}" Padding="28" MinHeight="230">
                <Grid ColumnSpacing="24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="DecisionIconBack" Width="96" Height="96" CornerRadius="48" VerticalAlignment="Top">
                        <FontIcon x:Name="DecisionIcon" FontSize="44" Foreground="White" Glyph="&#xE8EA;" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="6">
                        <TextBlock x:Name="DecisionTitle" Text="Waiting for a scan" FontSize="40" FontWeight="Bold" />
                        <TextBlock x:Name="DecisionPlate" FontSize="24" FontFamily="Cascadia Mono, Consolas" />
                        <TextBlock x:Name="DecisionPax" FontSize="18" />
                        <TextBlock x:Name="DecisionReason" FontSize="16" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="DecisionMeta" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Manual scan (handheld trigger without hardware) -->
            <Border Style="{StaticResource CardStyle}" Padding="20">
                <StackPanel Spacing="10">
                    <TextBlock Text="Manual scan" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Type a licence plate or EPC, or pick a recently seen tag, to scan it at the ramp as if the handheld read it."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AutoSuggestBox x:Name="ManualBox" PlaceholderText="0706100651 or E2003009…" FontSize="18"
                                        TextChanged="Manual_TextChanged" QuerySubmitted="Manual_QuerySubmitted" />
                        <Button Grid.Column="1" Click="ManualScan_Click" Style="{StaticResource AccentButtonStyle}" MinHeight="44" MinWidth="140">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8EA;" FontSize="16" />
                                <TextBlock Text="Scan" FontSize="16" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ManualError" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Recent decisions -->
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="16,12">
                    <TextBlock Text="Recent load decisions" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ToggleSwitch x:Name="RealOnly" HorizontalAlignment="Right" OnContent="Real tags only" OffContent="All" IsOn="False" MinWidth="0" Toggled="RealOnly_Toggled" />
                </Grid>
                <ListView x:Name="DecisionList" Grid.Row="1" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:DecisionViewModel">
                            <Grid ColumnSpacing="12" Padding="0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Width="32" Height="32" CornerRadius="16" Background="{x:Bind vm:Ui.DecisionBrush(Authorised)}" VerticalAlignment="Top">
                                    <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="White" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                                    <TextBlock>
                                        <Run Text="{x:Bind Plate}" FontFamily="Cascadia Mono, Consolas" />
                                        <Run Text=" · " />
                                        <Run Text="{x:Bind Passenger}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Reason}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                                    <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource CaptionTextBlockStyle}" HorizontalAlignment="Right"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
