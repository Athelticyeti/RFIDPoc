<Page
    x:Class="KQ.Brs.Poc.Views.MapPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Page.Resources>
        <ResourceDictionary>
            <Style x:Key="ZoneEyebrow" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Foreground" Value="{ThemeResource MapLabel}" />
            </Style>
            <Style x:Key="ZoneTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource MapTitle}" />
            </Style>
            <Style x:Key="RegionLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource MapLabel}" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Padding="28,12,28,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: title, live counts, tracker -->
        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Live map" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="Subtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel x:Name="Legend" Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,4" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <AutoSuggestBox x:Name="TrackBox" Width="300" PlaceholderText="Track a bag: passenger or plate" QueryIcon="Find"
                                TextChanged="TrackBox_TextChanged" SuggestionChosen="TrackBox_SuggestionChosen" QuerySubmitted="TrackBox_QuerySubmitted" />
                <Button x:Name="StopTrackButton" Content="Show all bags" Click="StopTrack_Click" Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <!-- The floor plan (1600 × 840 design units, scaled to fit) -->
        <Border Grid.Row="1" CornerRadius="10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" Background="{ThemeResource MapGround}">
            <Viewbox Stretch="Uniform" Margin="8">
                <Canvas x:Name="Map" Width="1600" Height="840">
                    <Canvas x:Name="GridLayer" />

                    <!-- ===== Terminal 1A · check-in hall ===== -->
                    <Rectangle Canvas.Left="30" Canvas.Top="30" Width="430" Height="780" RadiusX="16" RadiusY="16"
                               Fill="{ThemeResource MapZone}" Stroke="{ThemeResource MapZoneStroke}" StrokeThickness="1.5" />
                    <TextBlock Canvas.Left="56" Canvas.Top="50" Text="TERMINAL 1A" Style="{StaticResource ZoneEyebrow}" />
                    <TextBlock Canvas.Left="56" Canvas.Top="70" Text="Check-in" Style="{StaticResource ZoneTitle}" />

                    <Rectangle Canvas.Left="56" Canvas.Top="140" Width="378" Height="196" RadiusX="10" RadiusY="10"
                               Fill="{ThemeResource MapRegion}" Stroke="{ThemeResource MapRegionStroke}" StrokeDashArray="3 3" />
                    <TextBlock x:Name="QueueLabel" Canvas.Left="70" Canvas.Top="150" Text="Awaiting check-in" Style="{StaticResource RegionLabel}" />

                    <Rectangle Canvas.Left="56" Canvas.Top="370" Width="378" Height="60" RadiusX="10" RadiusY="10" Fill="{ThemeResource MapCounter}"
                               Stroke="{ThemeResource MapZoneStroke}" />
                    <TextBlock Canvas.Left="74" Canvas.Top="388" Text="DESK 14" Style="{StaticResource ZoneEyebrow}" Foreground="{ThemeResource MapTitle}" />

                    <Rectangle Canvas.Left="56" Canvas.Top="470" Width="378" Height="316" RadiusX="10" RadiusY="10"
                               Fill="{ThemeResource MapRegion}" Stroke="{ThemeResource MapRegionStroke}" StrokeDashArray="3 3" />
                    <TextBlock x:Name="CheckedInLabel" Canvas.Left="70" Canvas.Top="480" Text="Checked in" Style="{StaticResource RegionLabel}" />

                    <!-- ===== Baggage hall · Belt 04 ===== -->
                    <Rectangle Canvas.Left="490" Canvas.Top="30" Width="570" Height="780" RadiusX="16" RadiusY="16"
                               Fill="{ThemeResource MapZone}" Stroke="{ThemeResource MapZoneStroke}" StrokeThickness="1.5" />
                    <TextBlock Canvas.Left="516" Canvas.Top="50" Text="BAGGAGE HALL" Style="{StaticResource ZoneEyebrow}" />
                    <TextBlock Canvas.Left="516" Canvas.Top="70" Text="Sorting · Belt 04" Style="{StaticResource ZoneTitle}" />

                    <Rectangle Canvas.Left="516" Canvas.Top="140" Width="518" Height="190" RadiusX="10" RadiusY="10"
                               Fill="{ThemeResource MapProblemRegion}" Stroke="{ThemeResource StatusExceptionBrush}" StrokeDashArray="3 3" StrokeThickness="1" />
                    <TextBlock x:Name="HallProblemLabel" Canvas.Left="530" Canvas.Top="150" Text="Problems in the hall" Style="{StaticResource RegionLabel}" />

                    <Rectangle Canvas.Left="516" Canvas.Top="470" Width="518" Height="316" RadiusX="10" RadiusY="10"
                               Fill="{ThemeResource MapRegion}" Stroke="{ThemeResource MapRegionStroke}" StrokeDashArray="3 3" />
                    <TextBlock x:Name="SortedLabel" Canvas.Left="530" Canvas.Top="480" Text="Sorted · KQ-504 make-up lane" Style="{StaticResource RegionLabel}" />

                    <!-- ===== Apron · Stand 5 ===== -->
                    <Rectangle Canvas.Left="1090" Canvas.Top="30" Width="480" Height="780" RadiusX="16" RadiusY="16"
                               Fill="{ThemeResource MapTarmac}" Stroke="{ThemeResource MapZoneStroke}" StrokeThickness="1.5" />
                    <TextBlock Canvas.Left="1116" Canvas.Top="50" Text="APRON · STAND 5" Style="{StaticResource ZoneEyebrow}" />
                    <TextBlock Canvas.Left="1116" Canvas.Top="70" Text="Loading · Hold 2" Style="{StaticResource ZoneTitle}" />

                    <!-- Stand markings -->
                    <Line X1="1110" Y1="620" X2="1550" Y2="620" Stroke="{ThemeResource MapMarking}" StrokeThickness="3" StrokeDashArray="6 4" Opacity="0.7" />
                    <Line X1="1400" Y1="530" X2="1400" Y2="790" Stroke="{ThemeResource MapMarking}" StrokeThickness="3" Opacity="0.5" />

                    <!-- ULD containers -->
                    <Path Canvas.Left="1116" Canvas.Top="136" Data="M 0,0 L 190,0 L 190,150 L 24,150 L 0,120 Z" Fill="{ThemeResource MapUld}"
                          Stroke="{ThemeResource MapAircraftStroke}" StrokeThickness="1.5" />
                    <TextBlock x:Name="Ak7Label" Canvas.Left="1130" Canvas.Top="144" Text="ULD AK7" Style="{StaticResource RegionLabel}" />
                    <Path Canvas.Left="1356" Canvas.Top="136" Data="M 0,0 L 190,0 L 190,150 L 24,150 L 0,120 Z" Fill="{ThemeResource MapUld}"
                          Stroke="{ThemeResource MapAircraftStroke}" StrokeThickness="1.5" />
                    <TextBlock x:Name="Ak8Label" Canvas.Left="1370" Canvas.Top="144" Text="ULD AK8" Style="{StaticResource RegionLabel}" />

                    <!-- Refused / held strip -->
                    <Rectangle Canvas.Left="1116" Canvas.Top="440" Width="430" Height="76" RadiusX="10" RadiusY="10"
                               Fill="{ThemeResource MapProblemRegion}" Stroke="{ThemeResource StatusExceptionBrush}" StrokeDashArray="3 3" StrokeThickness="1" />
                    <TextBlock x:Name="HeldLabel" Canvas.Left="1130" Canvas.Top="446" Text="Refused at loading" Style="{StaticResource RegionLabel}" />

                    <!-- Offloaded bay -->
                    <Rectangle Canvas.Left="1116" Canvas.Top="540" Width="96" Height="246" RadiusX="10" RadiusY="10"
                               Fill="{ThemeResource MapRegion}" Stroke="{ThemeResource MapRegionStroke}" StrokeDashArray="3 3" />
                    <TextBlock x:Name="OffloadLabel" Canvas.Left="1126" Canvas.Top="548" Text="Offloaded" Style="{StaticResource RegionLabel}" FontSize="12" />

                    <!-- Aircraft (top view, nose to the right): 520 × 420 design, scaled -->
                    <Canvas x:Name="Aircraft" Canvas.Left="1236" Canvas.Top="540">
                        <Canvas.RenderTransform>
                            <ScaleTransform ScaleX="0.6" ScaleY="0.6" />
                        </Canvas.RenderTransform>
                        <Path Fill="{ThemeResource MapAircraft}" Stroke="{ThemeResource MapAircraftStroke}" StrokeThickness="2.5"
                              Data="M 300,186 L 214,24 L 176,24 L 220,186 Z M 300,234 L 214,396 L 176,396 L 220,234 Z M 92,188 L 58,128 L 38,128 L 58,188 Z M 92,232 L 58,292 L 38,292 L 58,232 Z" />
                        <Rectangle Canvas.Left="236" Canvas.Top="96" Width="44" Height="18" RadiusX="9" RadiusY="9" Fill="{ThemeResource MapAircraft}" Stroke="{ThemeResource MapAircraftStroke}" StrokeThickness="2.5" />
                        <Rectangle Canvas.Left="236" Canvas.Top="306" Width="44" Height="18" RadiusX="9" RadiusY="9" Fill="{ThemeResource MapAircraft}" Stroke="{ThemeResource MapAircraftStroke}" StrokeThickness="2.5" />
                        <Path Fill="{ThemeResource MapAircraft}" Stroke="{ThemeResource MapAircraftStroke}" StrokeThickness="2.5"
                              Data="M 56,186 L 438,186 C 482,186 512,198 518,210 C 512,222 482,234 438,234 L 56,234 C 40,234 30,222 30,210 C 30,198 40,186 56,186 Z" />
                        <Path Fill="{ThemeResource MapAircraftStroke}" Data="M 486,200 C 498,203 504,206 507,210 C 504,214 498,217 486,220 Z" />
                        <!-- Hold 2 (aft cargo hold) -->
                        <Rectangle x:Name="Hold2" Canvas.Left="120" Canvas.Top="192" Width="96" Height="36" RadiusX="6" RadiusY="6"
                                   Fill="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0.9" />
                        <TextBlock Canvas.Left="134" Canvas.Top="196" Text="HOLD 2" FontSize="20" FontWeight="Bold" Foreground="White" />
                        <TextBlock Canvas.Left="300" Canvas.Top="196" Text="KQ 504" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource MapLabel}" />
                    </Canvas>

                    <!-- ===== The belt: Desk 14 → tunnel → loading point ===== -->
                    <Path Data="M 250,400 L 1250,400" Stroke="{ThemeResource MapBelt}" StrokeThickness="34" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path x:Name="BeltStripes" Data="M 250,400 L 1250,400" Stroke="{ThemeResource MapBeltStripe}" StrokeThickness="26"
                          StrokeDashArray="0.18 0.9" StrokeDashCap="Flat" />

                    <!-- Tunnel housing over the belt -->
                    <Rectangle Canvas.Left="700" Canvas.Top="352" Width="200" Height="96" RadiusX="12" RadiusY="12" Fill="{ThemeResource MapTunnel}" Opacity="0.92" />
                    <StackPanel Canvas.Left="700" Canvas.Top="376" Width="200" Spacing="2">
                        <TextBlock Text="TUNNEL" HorizontalAlignment="Center" FontSize="14" FontWeight="Bold" CharacterSpacing="160" Foreground="White" Opacity="0.85" />
                        <TextBlock Text="reads the tag from both sides" HorizontalAlignment="Center" FontSize="11" Foreground="White" Opacity="0.75" />
                    </StackPanel>

                    <!-- What the tunnel decides: on the KQ-504 list → Sorted (below); anything else → Problems (above) -->
                    <Path Data="M 1000,382 L 1000,328" Stroke="{ThemeResource StatusExceptionBrush}" StrokeThickness="3" />
                    <Path Data="M 992,334 L 1000,320 L 1008,334 Z" Fill="{ThemeResource StatusExceptionBrush}" />
                    <TextBlock Canvas.Left="705" Canvas.Top="297" Width="320" TextAlignment="Right" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource StatusExceptionBrush}" Text="✗ wrong flight · offloaded · unknown tag" />
                    <Path Data="M 1000,418 L 1000,472" Stroke="{ThemeResource StatusMatchedBrush}" StrokeThickness="3" />
                    <Path Data="M 992,466 L 1000,480 L 1008,466 Z" Fill="{ThemeResource StatusMatchedBrush}" />
                    <TextBlock Canvas.Left="805" Canvas.Top="489" Width="220" TextAlignment="Right" FontSize="12" FontWeight="SemiBold"
                               Foreground="{ThemeResource StatusMatchedBrush}" Text="✓ on the KQ-504 list" />

                    <!-- Route highlight for the tracked bag (drawn over the belt) -->
                    <Path x:Name="RouteDeskToTunnel" Data="M 250,400 L 700,400" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                    <Path x:Name="RouteTunnelToLoading" Data="M 900,400 L 1250,400" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                    <Path x:Name="RouteLoadingToUld" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeDashArray="1.2 1" Visibility="Collapsed" />

                    <!-- Live layers -->
                    <Canvas x:Name="DotLayer" />
                    <Canvas x:Name="BeaconLayer" />

                    <!-- The tunnel's latest decision, for a few seconds after each read (right edge at x 690, left of the tunnel) -->
                    <Border x:Name="TunnelDecision" Canvas.Top="347" CornerRadius="13" Padding="12,4" Visibility="Collapsed" IsHitTestVisible="False">
                        <TextBlock x:Name="TunnelDecisionText" FontSize="13" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                </Canvas>
            </Viewbox>
        </Border>

        <!-- Journey strip for the tracked bag -->
        <Border x:Name="JourneyCard" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="18,12" Visibility="Collapsed">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" MinWidth="200">
                    <TextBlock x:Name="JourneyName" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="JourneyPlate" Style="{StaticResource MonoTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Grid x:Name="JourneySteps" Grid.Column="1" ColumnSpacing="0" />
                <Button Grid.Column="2" Content="Bag details" Click="JourneyDetails_Click" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Page>
