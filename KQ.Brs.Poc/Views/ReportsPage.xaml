<Page
    x:Class="KQ.Brs.Poc.Views.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="28,12,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Evaluation report" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="Generated" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Text="Read rate per scan point and antenna, missed reads, exceptions and time to resolve (FR-13)." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Click="Refresh_Click" Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <DropDownButton Content="Export">
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Markdown report (.md)" Click="ExportMd_Click" />
                            <MenuFlyoutItem Text="Data (.csv)" Click="ExportCsv_Click" />
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel x:Name="Body" Spacing="16" />
        </ScrollViewer>
        <ProgressRing x:Name="Busy" Grid.Row="1" IsActive="False" />
    </Grid>
</Page>
