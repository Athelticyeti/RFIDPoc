<Page
    x:Class="KQ.Brs.Poc.Views.ExceptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KQ.Brs.Poc.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="28,12,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Exceptions" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Wrong-flight bags, unknown tags and load refusals lock the ramp handheld until the bag is rescanned or a supervisor overrides (spec 7.2). Every action is written to the audit trail."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="StateBar" SelectionChanged="StateBar_Changed">
                <SelectorBarItem Text="Open" Tag="Open" IsSelected="True" />
                <SelectorBarItem Text="Acknowledged" Tag="Acknowledged" />
                <SelectorBarItem Text="Resolved" Tag="Resolved" />
                <SelectorBarItem Text="All" Tag="All" />
            </SelectorBar>
            <ToggleSwitch x:Name="RealOnly" Grid.Column="1" OnContent="Real tags only" OffContent="Real and virtual" MinWidth="0" Toggled="Filter_Changed" />
        </Grid>

        <Grid Grid.Row="2">
            <ListView x:Name="List" SelectionMode="None">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ExceptionRowViewModel">
                        <Border Style="{StaticResource CardStyle}" Padding="0">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="5" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="8,0,0,8" Background="{x:Bind vm:Ui.SeverityBrush(IsCritical), Mode=OneWay}" />
                                <FontIcon Grid.Column="1" Glyph="{x:Bind Glyph}" FontSize="22" Margin="8,16,0,0" VerticalAlignment="Top"
                                          Foreground="{x:Bind vm:Ui.SeverityBrush(IsCritical), Mode=OneWay}" />
                                <StackPanel Grid.Column="2" Padding="0,12" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <TextBlock Text="{x:Bind TypeText}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{x:Bind Plate}" Style="{StaticResource MonoTextStyle}" VerticalAlignment="Center" />
                                        <Border CornerRadius="4" Padding="6,0" Background="{ThemeResource LaneBrush}">
                                            <TextBlock Text="{x:Bind SourceText}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                        <Border CornerRadius="4" Padding="6,0" Background="{ThemeResource LaneBrush}">
                                            <TextBlock Text="{x:Bind StateText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{x:Bind Exception.Message, Mode=OneWay}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                        <Run Text="Raised" /> <Run Text="{x:Bind RaisedText}" /> <Run Text="{x:Bind AgeText, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind ResolutionText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource StatusMatchedBrush}" Visibility="{x:Bind vm:Ui.Collapsed(IsOpen), Mode=OneWay}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Padding="0,0,16,0" VerticalAlignment="Center">
                                    <Button Content="View bag" Tag="{x:Bind Plate}" Click="ViewBag_Click" />
                                    <Button Content="Acknowledge" Tag="{x:Bind Id}" Click="Ack_Click" Visibility="{x:Bind vm:Ui.Visible(CanAcknowledge), Mode=OneWay}" />
                                    <Button Content="Resolve…" Tag="{x:Bind Id}" Click="Resolve_Click" Visibility="{x:Bind vm:Ui.Visible(CanResolve), Mode=OneWay}" />
                                    <Button Content="Override…" Tag="{x:Bind Id}" Click="Override_Click" Visibility="{x:Bind vm:Ui.Visible(CanOverride), Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="Empty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Visibility="Collapsed">
                <FontIcon Glyph="&#xE73E;" FontSize="40" Foreground="{ThemeResource StatusMatchedBrush}" />
                <TextBlock Text="Nothing here" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
