<Page
    x:Class="KQ.Brs.Poc.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tk="using:CommunityToolkit.WinUI.Controls">

    <Grid Padding="28,12,28,0" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                <TextBlock x:Name="SavedText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Save" Click="Save_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="110" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="4" MaxWidth="1000" HorizontalAlignment="Left" Padding="0,0,0,32">

                <TextBlock Text="Reader" Style="{StaticResource SectionHeaderStyle}" Margin="0,8,0,4" />
                <tk:SettingsExpander Header="Alien ALR-9900+ connection" Description="Telnet command port and the tag stream this PC listens on." IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE701;" /></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Reader IP address"><TextBox x:Name="HostBox" MinWidth="220" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Command port"><NumberBox x:Name="PortBox" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" MinWidth="140" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Username"><TextBox x:Name="UserBox" MinWidth="220" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Password" Description="Stored encrypted for your Windows account (DPAPI)."><PasswordBox x:Name="PasswordBox" MinWidth="220" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Tag stream port" Description="The reader connects to this PC on this port. Allow it through Windows Firewall."><NumberBox x:Name="StreamPortBox" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" MinWidth="140" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Connect and stream on start"><ToggleSwitch x:Name="AutoConnectToggle" /></tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <tk:SettingsExpander Header="Antenna → scan point" Description="Which scan point each antenna simulates. Minimum RSSI drops weak cross-reads from neighbouring antennas on the bench." IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE8B1;" /></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="POC demo defaults" Description="Check-in on antenna 0 (minimum RSSI 10,000) · sorting tunnel on antennas 1 and 2 (1,500) · loading on antenna 3 (800), armed · 3 s de-duplication. Fills in everything below and saves.">
                            <Button Content="Set POC defaults" Click="PocDefaults_Click" Style="{StaticResource AccentButtonStyle}" />
                        </tk:SettingsCard>
                        <tk:SettingsCard x:Name="Ant0Card" Header="Antenna 0" />
                        <tk:SettingsCard x:Name="Ant1Card" Header="Antenna 1" />
                        <tk:SettingsCard x:Name="Ant2Card" Header="Antenna 2" />
                        <tk:SettingsCard x:Name="Ant3Card" Header="Antenna 3" />
                        <tk:SettingsCard Header="Arm the loading antenna (3) when the app starts" Description="Off: reads at antenna 3 are ignored until you arm it on the Loading · Hold 2 page.">
                            <ToggleSwitch x:Name="ArmLoadingToggle" />
                        </tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>

                <tk:SettingsCard Header="De-duplication window" Description="Reads of the same tag at the same scan point within this quiet period count as one scan (spec 3.4.1).">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE916;" /></tk:SettingsCard.HeaderIcon>
                    <NumberBox x:Name="DedupeBox" Minimum="0.5" Maximum="30" SmallChange="0.5" SpinButtonPlacementMode="Compact" MinWidth="140" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Show 'Tag not linked' alerts" Description="Pop up an alert when a tag nobody is waiting for is held at check-in. Off: it is only listed on Live reads.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7E7;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="UnlinkedAlertsToggle" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Raise an exception for unknown tags at the belt" Description="Off: unknown tags are only counted as strays. Unknown tags at the ramp always alarm.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE9CE;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="UnknownBeltToggle" />
                </tk:SettingsCard>

                <TextBlock Text="Load rules (FR-05)" Style="{StaticResource SectionHeaderStyle}" Margin="0,20,0,4" />
                <tk:SettingsExpander Header="Authorise loading only if…" IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE72E;" /></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Authority to load is Y (ticket valid)"><ToggleSwitch x:Name="RuleAuthority" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Passenger is not a no-show"><ToggleSwitch x:Name="RuleNoShow" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Bag was verified at the check-in desk"><ToggleSwitch x:Name="RuleDesk" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Bag was read by the sorting tunnel (Belt 04)" Description="Off: a missed belt read only raises a warning."><ToggleSwitch x:Name="RuleBelt" /></tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
                <tk:SettingsCard Header="Supervisor PIN" Description="Required to override a ramp alarm.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE192;" /></tk:SettingsCard.HeaderIcon>
                    <PasswordBox x:Name="PinBox" MinWidth="140" />
                </tk:SettingsCard>

                <TextBlock Text="Simulator" Style="{StaticResource SectionHeaderStyle}" Margin="0,20,0,4" />
                <tk:SettingsCard Header="Show simulator" Description="Off: the app uses only the real reader and real tags, and hides the virtual-bags simulator. On: shows its settings, the 700 demo bags option and the start button on the Dashboard.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="SimulatorToggle" Toggled="SimulatorToggle_Toggled" />
                </tk:SettingsCard>
                <StackPanel x:Name="SimulatorPanel" Spacing="4">
                <tk:SettingsExpander Header="Virtual bags" Description="The bags not reserved for real tags travel Desk 14 → Belt 04 → Ramp on a virtual clock." IsExpanded="True">
                    <tk:SettingsExpander.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></tk:SettingsExpander.HeaderIcon>
                    <tk:SettingsExpander.Items>
                        <tk:SettingsCard Header="Real-tag pool" Description="The last N bags are reserved for physical tags bound at the desk. Takes effect after Clean database.">
                            <NumberBox x:Name="PoolBox" Minimum="0" Maximum="200" SpinButtonPlacementMode="Compact" MinWidth="140" />
                        </tk:SettingsCard>
                        <tk:SettingsCard Header="Passengers who don't board"><NumberBox x:Name="SimNoBoardBox" Minimum="0" Maximum="50" SpinButtonPlacementMode="Compact" MinWidth="140" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Deleted BSMs (offloads)"><NumberBox x:Name="SimDelBox" Minimum="0" Maximum="50" SpinButtonPlacementMode="Compact" MinWidth="140" /></tk:SettingsCard>
                        <tk:SettingsCard Header="KQ-412 misroutes"><NumberBox x:Name="SimMisrouteBox" Minimum="0" Maximum="50" SpinButtonPlacementMode="Compact" MinWidth="140" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Missed belt reads (%)"><NumberBox x:Name="SimMissedBox" Minimum="0" Maximum="50" SmallChange="0.5" SpinButtonPlacementMode="Compact" MinWidth="140" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Stray tags"><NumberBox x:Name="SimStrayBox" Minimum="0" Maximum="50" SpinButtonPlacementMode="Compact" MinWidth="140" /></tk:SettingsCard>
                        <tk:SettingsCard Header="Random seed" Description="Same seed, same run."><NumberBox x:Name="SeedBox" Minimum="0" Maximum="999999" SpinButtonPlacementMode="Compact" MinWidth="140" /></tk:SettingsCard>
                    </tk:SettingsExpander.Items>
                </tk:SettingsExpander>
                <tk:SettingsCard Header="Generate 700 demo bags" Description="Off: the flight starts empty and you add each passenger from the Dashboard. On: a generated KQ-504 manifest for the virtual-bags simulator. Takes effect after Clean database.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7F4;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="DemoBagsToggle" />
                </tk:SettingsCard>
                </StackPanel>

                <TextBlock Text="Demo" Style="{StaticResource SectionHeaderStyle}" Margin="0,20,0,4" />
                <tk:SettingsCard Header="Show misroute demo (Flag tag as KQ-412)" Description="Adds a button to bag details that turns a tag into a bag for another flight, so you can show the wrong-flight alarm (spec 7.2). Undo is always available on a flagged bag.">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE7BA;" /></tk:SettingsCard.HeaderIcon>
                    <ToggleSwitch x:Name="MisrouteToggle" />
                </tk:SettingsCard>
                <tk:SettingsCard Header="Clean database" Description="Permanently deletes every passenger, bag, tag link, scan, exception, message and the audit trail. The flight starts empty (or with the demo bags, if switched on above).">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE74D;" Foreground="{ThemeResource SystemFillColorCriticalBrush}" /></tk:SettingsCard.HeaderIcon>
                    <Button Click="CleanDatabase_Click" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}"
                            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74D;" FontSize="14" />
                            <TextBlock Text="Clean database…" />
                        </StackPanel>
                    </Button>
                </tk:SettingsCard>
                <tk:SettingsCard Header="Data folder" Description="SQLite database (audit trail), settings and error log." IsClickEnabled="True" Click="DataFolder_Click">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE8B7;" /></tk:SettingsCard.HeaderIcon>
                    <tk:SettingsCard.ActionIcon><FontIcon Glyph="&#xE8A7;" /></tk:SettingsCard.ActionIcon>
                </tk:SettingsCard>

                <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" Margin="0,20,0,4" />
                <tk:SettingsCard Header="Theme">
                    <tk:SettingsCard.HeaderIcon><FontIcon Glyph="&#xE790;" /></tk:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="ThemeBox" MinWidth="160" SelectionChanged="Theme_Changed">
                        <x:String>Use Windows setting</x:String>
                        <x:String>Light</x:String>
                        <x:String>Dark</x:String>
                    </ComboBox>
                </tk:SettingsCard>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
