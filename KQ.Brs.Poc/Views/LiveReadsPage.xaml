<Page
    x:Class="KQ.Brs.Poc.Views.LiveReadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KQ.Brs.Poc.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="28,12,28,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Live reads" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="Alien ALR-9900+ EMA in autonomous mode, pushing every read over the tag stream (no polling). Each antenna simulates one scan point."
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Reader -->
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="22" Background="{ThemeResource LaneBrush}">
                            <FontIcon Glyph="&#xE701;" FontSize="20" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ReaderTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="ReaderSub" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <InfoBar x:Name="ReaderInfo" IsOpen="True" IsClosable="False" />
                    <Grid ColumnSpacing="16" RowSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Command port" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="CommandText" Grid.Column="1" Style="{StaticResource MonoTextStyle}" />
                        <TextBlock Grid.Row="1" Text="Tag stream to" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="StreamText" Grid.Row="1" Grid.Column="1" Style="{StaticResource MonoTextStyle}" />
                        <TextBlock Grid.Row="2" Text="Reads / reconnects" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="CountersText" Grid.Row="2" Grid.Column="1" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ConnectButton" Click="Connect_Click" Style="{StaticResource AccentButtonStyle}" MinWidth="120" />
                        <Button x:Name="StreamButton" Click="Stream_Click" MinWidth="120" />
                        <Button x:Name="DiscoverButton" Click="Discover_Click" ToolTipService.ToolTip="Listen for reader heartbeats (UDP 3988, up to 35 s)">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE721;" FontSize="14" />
                                <TextBlock Text="Discover" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="DiscoverText" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Antennas -->
            <ItemsControl x:Name="AntennaCards" Grid.Column="1">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VariableSizedWrapGrid Orientation="Horizontal" MaximumRowsOrColumns="2" ItemWidth="470" ItemHeight="168" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AntennaCardViewModel">
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12" Padding="16,12" Opacity="{x:Bind vm:AntennaCardViewModel.Dim(Enabled), Mode=OneWay}">
                            <Grid ColumnSpacing="16" RowSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ScanPointName, Mode=OneWay}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                                    <TextBlock Text="{x:Bind ReadsPerSecond, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                                    <TextBlock Text="reads/s" VerticalAlignment="Bottom" Margin="0,0,0,3" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <Polyline Grid.Row="1" Grid.ColumnSpan="2" Points="{x:Bind Spark, Mode=OneWay}" Height="46" Stroke="{ThemeResource AccentFillColorDefaultBrush}"
                                          StrokeThickness="2" StrokeLineJoin="Round" />
                                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="18" VerticalAlignment="Bottom">
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"><Run Text="Unique " Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{x:Bind Unique, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"><Run Text="Total " Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{x:Bind Total, Mode=OneWay}" /></TextBlock>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"><Run Text="Last " Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{x:Bind LastEpc, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" /></TextBlock>
                                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}"><Run Text="RSSI " Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Run Text="{x:Bind Rssi, Mode=OneWay}" /></TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Logs -->
        <Grid Grid.Row="2" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Processed scans (real tags, after de-duplication)" Margin="16,12" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <ListView x:Name="ScanList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScanLogViewModel">
                                <Grid ColumnSpacing="12" Padding="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Time}" Style="{StaticResource MonoTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind ScanPoint}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Plate}" Style="{StaticResource MonoTextStyle}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Outcome}" FontWeight="SemiBold"
                                               Foreground="{x:Bind vm:Ui.SeverityBrush(IsProblem)}" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind Detail}" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,12" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Raw tag stream" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <ToggleSwitch x:Name="PauseRaw" Grid.Column="1" OnContent="Paused" OffContent="Live" MinWidth="0" />
                    </Grid>
                    <ListView x:Name="RawList" Grid.Row="1" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Style="{StaticResource MonoTextStyle}" FontSize="12" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
