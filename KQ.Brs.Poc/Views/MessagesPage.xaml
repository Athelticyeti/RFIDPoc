<Page
    x:Class="KQ.Brs.Poc.Views.MessagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:KQ.Brs.Poc.ViewModels"
    NavigationCacheMode="Required">

    <Grid Padding="28,12,28,24" RowSpacing="16" ColumnSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Type B messages" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="BSMs in from the DCS (simulated feed), BPM and BUM out through the outbox. RP 1745-style formats (POC; not yet checked against KQ/SITA samples)."
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="16,8" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <ToggleSwitch x:Name="MqToggle" Header="IBM MQ link (simulated)" OnContent="Up" OffContent="Down - queuing" IsOn="True" Toggled="Mq_Toggled" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Queued in outbox" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock x:Name="QueuedText" Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <SelectorBar x:Name="BoxBar" Grid.Row="1" SelectionChanged="BoxBar_Changed">
            <SelectorBarItem x:Name="InboxItem" Text="Inbox (BSM)" Tag="In" IsSelected="True" />
            <SelectorBarItem x:Name="OutboxItem" Text="Outbox (BPM, BUM)" Tag="Out" />
        </SelectorBar>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="0">
            <ListView x:Name="List" SelectionMode="Single" SelectionChanged="List_SelectionChanged" Padding="0,6">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:MessageRowViewModel">
                        <Grid ColumnSpacing="12" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="78" />
                                <ColumnDefinition Width="110" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="4" Padding="6,2" Background="{ThemeResource LaneBrush}" HorizontalAlignment="Left">
                                <TextBlock Text="{x:Bind TypeText}" FontWeight="Bold" FontSize="12" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{x:Bind CreatedText}" Style="{StaticResource MonoTextStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Plate}" Style="{StaticResource MonoTextStyle}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind Summary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="4" Text="{x:Bind StateText}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{x:Bind vm:Ui.QueuedBrush(IsQueued)}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <StackPanel Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Spacing="16">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Message" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Name="ParsedText" TextWrapping="Wrap" Text="Select a message to see it parsed." Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Border Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6" Padding="12">
                        <TextBlock x:Name="RawText" Style="{StaticResource MonoTextStyle}" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Send a Type B message to the BRS" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock Text="Same as POST /api/v1/messages/typeb: e.g. a BSM CHG with .S/N to make a passenger a no-show, or DEL to offload a bag."
                               TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox x:Name="PasteBox" AcceptsReturn="True" MinHeight="170" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Apply" Click="Apply_Click" Style="{StaticResource AccentButtonStyle}" />
                        <Button Content="Example: no-show CHG" Click="Example_Click" />
                        <TextBlock x:Name="ApplyResult" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
