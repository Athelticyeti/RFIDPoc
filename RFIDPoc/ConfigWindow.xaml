<Window x:Class="RFIDPoc.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reader Configuration" Height="750" Width="1100" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="8">
        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <Button x:Name="RefreshButton" Content="Refresh" Padding="10,2" Click="RefreshButton_Click"/>
            <Button x:Name="ApplyButton" Content="Apply Changes" Margin="6,0,0,0" Padding="10,2" FontWeight="Bold" Click="ApplyButton_Click"/>
            <Button x:Name="DiscardButton" Content="Discard Edits" Margin="6,0,0,0" Padding="10,2" Click="DiscardButton_Click"/>
            <Button x:Name="SyncClockButton" Content="Sync Clock to PC" Margin="20,0,0,0" Padding="10,2" Click="SyncClockButton_Click"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </StackPanel>

        <!-- Raw CLI command -->
        <GroupBox DockPanel.Dock="Bottom" Header="Raw CLI command (sent as-is via SDK SendReceive)" Margin="0,6,0,0">
            <DockPanel Margin="4">
                <DockPanel DockPanel.Dock="Top">
                    <Button x:Name="SendButton" DockPanel.Dock="Right" Content="Send" Padding="12,2" Margin="6,0,0,0" Click="SendButton_Click" IsDefault="True"/>
                    <TextBox x:Name="CommandBox" FontFamily="Consolas" VerticalContentAlignment="Center" Text="Get AntennaStatus"/>
                </DockPanel>
                <TextBox x:Name="CommandOutput" Height="90" Margin="0,4,0,0" IsReadOnly="True" FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </GroupBox>

        <!-- Settings -->
        <DataGrid x:Name="SettingsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserSortColumns="False" HeadersVisibility="Column" SelectionMode="Single" RowHeaderWidth="0">
            <DataGrid.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="13" Margin="2,8,0,2"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </DataGrid.GroupStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                            <Setter Property="Background" Value="#FFF4D6"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Setting" Binding="{Binding Name}" IsReadOnly="True" Width="170"/>
                <DataGridTextColumn Header="Current" Binding="{Binding Current}" IsReadOnly="True" Width="170" FontFamily="Consolas"/>
                <DataGridTemplateColumn Header="New Value" Width="190">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox IsEditable="True" IsEnabled="{Binding IsEditable}" ItemsSource="{Binding Options}"
                                      Text="{Binding NewValue, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" IsReadOnly="True" Width="150"/>
                <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
