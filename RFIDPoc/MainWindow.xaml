<Window x:Class="RFIDPoc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFID PoC - Alien Reader" Height="650" Width="950" Closing="Window_Closing">
    <DockPanel Margin="8">
        <!-- Connection -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="IP:" VerticalAlignment="Center" Margin="0,0,4,0"/>
            <TextBox x:Name="IpBox" Width="120" Text="192.168.0.161" VerticalContentAlignment="Center"/>
            <TextBlock Text="Port:" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <TextBox x:Name="PortBox" Width="50" Text="23" VerticalContentAlignment="Center"/>
            <TextBlock Text="User:" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <TextBox x:Name="UserBox" Width="70" Text="alien" VerticalContentAlignment="Center"/>
            <TextBlock Text="Password:" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <PasswordBox x:Name="PasswordBox" Width="80" Password="password" VerticalContentAlignment="Center"/>
            <Button x:Name="DiscoverButton" Content="Discover" Margin="10,0,0,0" Padding="10,2" Click="DiscoverButton_Click"/>
            <Button x:Name="ConnectButton" Content="Connect" Margin="6,0,0,0" Padding="10,2" Click="ConnectButton_Click"/>
        </StackPanel>

        <!-- Reading -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
            <ComboBox x:Name="LiveModeBox" SelectedIndex="0" Width="150" VerticalContentAlignment="Center" Margin="0,0,6,0">
                <ComboBoxItem Content="Stream (every read)" ToolTip="Reader sends each tag read the moment it happens (Tag Stream)."/>
                <ComboBoxItem Content="Notify (per cycle)" ToolTip="Reader sends its tag list at the end of a read cycle when tags change (Notify)."/>
            </ComboBox>
            <Button x:Name="LiveButton" Content="Start Live" Padding="10,2" FontWeight="Bold" IsEnabled="False" Click="LiveButton_Click"
                    ToolTip="Event-driven: reader reads continuously and pushes data to this PC (no polling)."/>
            <Button x:Name="ReadOnceButton" Content="Read Once" Margin="16,0,0,0" Padding="10,2" IsEnabled="False" Click="ReadOnceButton_Click"/>
            <Button x:Name="PollButton" Content="Start Polling" Margin="6,0,0,0" Padding="10,2" IsEnabled="False" Click="PollButton_Click"/>
            <TextBlock Text="Interval (ms):" VerticalAlignment="Center" Margin="10,0,4,0"/>
            <TextBox x:Name="IntervalBox" Width="50" Text="500" VerticalContentAlignment="Center"/>
            <Button Content="Clear" Margin="10,0,0,0" Padding="10,2" Click="ClearButton_Click"/>
            <Button x:Name="ConfigButton" Content="Reader Config..." Margin="10,0,0,0" Padding="10,2" IsEnabled="False" Click="ConfigButton_Click"/>
            <TextBlock x:Name="StatusText" Text="Disconnected" VerticalAlignment="Center" Margin="16,0,0,0" FontWeight="Bold"/>
        </StackPanel>

        <TextBlock x:Name="UpdateText" DockPanel.Dock="Top" Margin="0,0,0,6" Foreground="DimGray"/>

        <!-- Log -->
        <TextBox x:Name="LogBox" DockPanel.Dock="Bottom" Height="150" Margin="0,6,0,0" IsReadOnly="True"
                 FontFamily="Consolas" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto"/>

        <!-- Tags -->
        <DataGrid x:Name="TagGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="EPC / Tag ID" Binding="{Binding TagId}" Width="*" FontFamily="Consolas"/>
                <DataGridTextColumn Header="Antenna" Binding="{Binding Antenna}" Width="70"/>
                <DataGridTextColumn Header="Reads" Binding="{Binding ReadCount}" Width="70"/>
                <DataGridTextColumn Header="RSSI" Binding="{Binding Rssi}" Width="70"/>
                <DataGridTextColumn Header="First Seen" Binding="{Binding FirstSeen, StringFormat=HH:mm:ss}" Width="90"/>
                <DataGridTextColumn Header="Last Seen" Binding="{Binding LastSeen, StringFormat=HH:mm:ss}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
