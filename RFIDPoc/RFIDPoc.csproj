<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- Alien RFID .NET SDK 2.3.2 (built for .NET Framework 2.0; loads on .NET via the compatibility shim). -->
  <ItemGroup>
    <Reference Include="AlienRFID2">
      <HintPath>..\lib\AlienRFID2\AlienRFID2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <!-- The SDK always constructs a SerialPort (even for network readers); not part of the .NET shared framework. -->
    <PackageReference Include="System.IO.Ports" Version="10.0.12" />
    <!-- The SDK splits reader replies with string.IndexOf("\0"), which under ICU (the .NET 5+ default) always
         returns 0 and truncates every reply to one character. NLS restores .NET Framework behavior. -->
    <RuntimeHostConfigurationOption Include="System.Globalization.UseNls" Value="true" />
  </ItemGroup>

  <!-- Shared Alien reader code (tag stream listener, reader lock), also used by the KQ baggage POC. -->
  <ItemGroup>
    <ProjectReference Include="..\KQ.Rfid.Alien\KQ.Rfid.Alien.csproj" />
  </ItemGroup>

</Project>
